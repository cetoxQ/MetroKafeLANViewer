<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Yalnızca bildirim alanı simgesi (NotifyIcon) için; WPF türleriyle çakışmasın diye global using'leri kaldırılır -->
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>MetroKafeLANViewer</AssemblyName>
    <RootNamespace>MetroKafeLANViewer</RootNamespace>
    <Product>Metro Kafe LAN Viewer</Product>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>tr</SatelliteResourceLanguages>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Sıkıştırma kapalı: açık olursa tüm DLL'ler belleğe açılır (~70 MB fazla RAM); zip zaten sıkıştırır -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <!-- MAC üretici listesi (Wireshark manuf'tan: "önek<TAB>üretici", gzip) -->
    <EmbeddedResource Include="Data\oui.gz" LogicalName="oui.gz" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
