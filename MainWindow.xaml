<Window x:Class="MetroKafeLANViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Metro Kafe LAN Viewer" Width="1280" Height="820" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Style="{StaticResource DarkWindow}"
        Icon="app.ico">
    <Window.Resources>
        <!-- Kutu boyutu: tüm kutular bu tek ölçeği kullanır (Kutu boyutu çubuğu) -->
        <ScaleTransform x:Key="TileScale" ScaleX="1" ScaleY="1"/>

        <!-- Haritadaki IP kutusu -->
        <DataTemplate x:Key="TileTemplate">
            <Border Tag="tile" Width="78" Height="58" Margin="3" CornerRadius="6"
                    Background="{Binding Fill}" ToolTip="{Binding Tip}" LayoutTransform="{StaticResource TileScale}"
                    ToolTipService.InitialShowDelay="250" Cursor="Hand"
                    MouseLeftButtonDown="Tile_MouseDown" MouseRightButtonUp="Tile_RightClick">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{Binding Edge}"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Selected}" Value="True">
                                <Setter Property="BorderBrush" Value="White"/>
                                <Setter Property="BorderThickness" Value="3"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Viewbox Width="17" Height="17" Margin="0,1,5,0" Visibility="{Binding IconVisibility}" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="{Binding Icon}" Stroke="{Binding IconBrush}" StrokeThickness="2" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="{Binding Number}" FontSize="19" FontWeight="Bold" Foreground="{Binding NumberBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Margin="4,0" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel/>
        </ItemsPanelTemplate>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>

        <!-- Bölme boyutlandırılırken görünen 20 px ızgara -->
        <DrawingBrush x:Key="GridBrush" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute" Viewbox="0,0,20,20" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Geometry="M0,0 L20,0 M0,0 L0,20">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#2A3A5A" Thickness="1"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Alt kısımdaki bölme: başlık (simge, ad, sayı), kutular, sağ altta boyut tutamağı -->
        <DataTemplate x:Key="GroupTemplate">
            <Border Width="{Binding Width}" Height="{Binding Height}" CornerRadius="8"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="{StaticResource PanelBrush}" AllowDrop="True"
                    DragEnter="Group_DragOver" DragOver="Group_DragOver" DragLeave="Group_DragLeave" Drop="Group_Drop">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DropTarget}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="10,6,6,2" Background="Transparent" Cursor="SizeAll"
                                   ToolTip="Bölmeyi taşımak için başlıktan tutup istediğiniz yere sürükleyin (yanına ya da altına)"
                                   MouseLeftButtonDown="GroupHeader_MouseDown">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8A9;"
                                    ToolTip="Öteki bölmeleri bu bölmenin boyutuna getir" Click="GroupSameSize_Click"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding ButtonsVisibility}">
                                <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Adını / simgesini değiştir" Click="GroupEdit_Click"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Bölmeyi sil (içindekiler Diğer cihazlar'a döner)" Click="GroupDelete_Click"/>
                            </StackPanel>
                            <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{Binding Icon}" Stroke="{Binding IconBrush}" StrokeThickness="1.8" StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Hint}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5,0,5,8">
                            <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource TileTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}"/>
                        </ScrollViewer>
                    </DockPanel>
                    <Thumb HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="16" Height="16" Cursor="SizeNWSE"
                           ToolTip="Boyutu değiştirmek için sürükleyin (20 piksellik ızgaraya oturur)" DragStarted="Group_ResizeStart" DragDelta="Group_Resize" DragCompleted="Group_ResizeDone">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent">
                                    <Path Data="M14,4 L4,14 M14,9 L9,14" Stroke="#6B7891" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="ChipButton" TargetType="RadioButton" BasedOn="{StaticResource TabButton}">
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="LegendDot" TargetType="Border">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Margin" Value="14,0,6,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Üst çubuk -->
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="METRO KAFE" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text=" LAN Viewer" FontSize="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <RadioButton x:Name="TabMap" Content="Harita" Style="{StaticResource TabButton}" IsChecked="True" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabList" Content="Liste" Style="{StaticResource TabButton}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabEvents" Style="{StaticResource TabButton}" Checked="Tab_Checked">
                        <TextBlock x:Name="EventsTabText" Text="Olaylar" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    </RadioButton>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="AutoBox" Content="Otomatik tara, her" VerticalAlignment="Center" Click="AutoBox_Click"/>
                    <TextBox x:Name="IntervalBox" Width="52" Margin="8,0,6,0" HorizontalContentAlignment="Center" Padding="4,4"
                             ToolTip="Kaç saniyede / dakikada bir taransın (en az 15 saniye). Yazıp Enter'a basın."
                             LostFocus="Interval_Changed" KeyDown="IntervalBox_KeyDown"/>
                    <ComboBox x:Name="IntervalUnit" Width="64" Height="32" Margin="0,0,14,0" SelectionChanged="Interval_Changed">
                        <ComboBoxItem Content="sn"/>
                        <ComboBoxItem Content="dk"/>
                    </ComboBox>
                    <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" MinWidth="120" Click="ScanButton_Click">
                        <TextBlock x:Name="ScanButtonText" Text="Şimdi tara" Foreground="White"/>
                    </Button>
                    <Button Content="Dışa aktar" Margin="8,0,0,0" Click="Export_Click" ToolTip="Listeyi Excel'de açılabilen CSV olarak kaydet"/>
                    <Button Content="Ayarlar" Margin="8,0,0,0" Click="Settings_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Güncelleme bildirimi -->
        <Border x:Name="UpdateBanner" Grid.Row="1" Background="#13264A" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,1"
                Padding="14,8" Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="UpdateButton" DockPanel.Dock="Right" Content="Şimdi güncelle" Style="{StaticResource PrimaryButton}" Click="UpdateNow_Click"/>
                <TextBlock x:Name="UpdateText" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- Çakışma uyarısı -->
        <Border x:Name="ConflictBanner" Grid.Row="2" Background="#4A0F15" BorderBrush="{StaticResource DangerBrush}" BorderThickness="0,0,0,2"
                Padding="14,10" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Listede göster" Style="{StaticResource DangerButton}" VerticalAlignment="Top" Click="ShowConflicts_Click"/>
                <StackPanel>
                    <TextBlock x:Name="ConflictTitle" FontWeight="Bold" FontSize="15" Foreground="#FECACA"/>
                    <TextBlock x:Name="ConflictLines" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#FECACA" FontSize="13"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Harita -->
        <ScrollViewer x:Name="MapPanel" Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="14,10">
            <!-- Boş yerden sürükleyince seçim çerçevesi çizilir -->
            <Grid x:Name="MapContent" Background="Transparent">
            <StackPanel>
                <DockPanel Margin="3,0,3,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Kutu boyutu" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider x:Name="ScaleSlider" Width="130" Minimum="0.6" Maximum="1.8" SmallChange="0.05" LargeChange="0.1"
                                VerticalAlignment="Center" ValueChanged="ScaleSlider_ValueChanged" ToolTip="Haritadaki kutuların boyutu"/>
                        <Border Style="{StaticResource LegendDot}" Background="#0F2E1E" BorderBrush="#22C55E" Margin="20,0,6,0"/>
                        <TextBlock Text="İstemci" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        <Border Style="{StaticResource LegendDot}" Background="#5B1219" BorderBrush="#EF4444"/>
                        <TextBlock Text="Çakışma" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        <Border Style="{StaticResource LegendDot}" Background="#1E2A4A" BorderBrush="#3B82F6"/>
                        <TextBlock Text="Kamera" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        <Border Style="{StaticResource LegendDot}" Background="#2A2238" BorderBrush="#A78BFA"/>
                        <TextBlock Text="Diğer" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        <Border Style="{StaticResource LegendDot}" Background="#0F1522" BorderBrush="#1C2433"/>
                        <TextBlock Text="Boş" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="ClientHeader" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                </DockPanel>
                <ItemsControl x:Name="ClientTilesView" ItemTemplate="{StaticResource TileTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}"/>
                <DockPanel Margin="3,18,3,4">
                    <Button DockPanel.Dock="Right" Content="Otomatik diz" Click="GroupArrange_Click"
                            ToolTip="Bölmeleri soldan sağa, sığmayanı alta geçirerek boşluksuz dizer"/>
                    <Button DockPanel.Dock="Right" Content="+ Bölme ekle" Click="GroupAdd_Click" Margin="8,0,0,0"
                            ToolTip="Sunucular, modemler, aralık dışı istemciler gibi cihazları ayırmak için yeni bölme"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Diğer cihazlar ve bölmeler" Style="{StaticResource SectionTitle}" Margin="0"/>
                        <TextBlock x:Name="SelectionText" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </DockPanel>
                <WrapPanel x:Name="IconLegend" Margin="3,2,3,8"/>
                <ItemsControl x:Name="GroupsView" ItemTemplate="{StaticResource GroupTemplate}" Background="Transparent" Margin="0,0,0,10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            <Setter Property="Panel.ZIndex" Value="{Binding Z}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </StackPanel>
                <Canvas IsHitTestVisible="False">
                    <Rectangle x:Name="SelectRect" Visibility="Collapsed" Stroke="#3B82F6" StrokeThickness="1" Fill="#333B82F6"/>
                </Canvas>
            </Grid>
        </ScrollViewer>

        <!-- Liste -->
        <DockPanel x:Name="ListPanel" Grid.Row="3" Margin="14,10" Visibility="Collapsed">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid DockPanel.Dock="Right" Width="260">
                    <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged"/>
                    <TextBlock Text="Ara: IP, ad, MAC, üretici, not..." Foreground="{StaticResource MutedBrush}" Margin="10,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FAll" Content="Tümü" Style="{StaticResource ChipButton}" IsChecked="True" Checked="Filter_Checked"/>
                    <RadioButton x:Name="FConflict" Content="Çakışmalar" Style="{StaticResource ChipButton}" Checked="Filter_Checked"/>
                    <RadioButton x:Name="FCamera" Content="Kameralar" Style="{StaticResource ChipButton}" Checked="Filter_Checked"/>
                    <RadioButton x:Name="FClient" Content="İstemciler" Style="{StaticResource ChipButton}" Checked="Filter_Checked"/>
                    <RadioButton x:Name="FOther" Content="Diğer" Style="{StaticResource ChipButton}" Checked="Filter_Checked"/>
                    <RadioButton x:Name="FOnline" Content="Açık olanlar" Style="{StaticResource ChipButton}" Checked="Filter_Checked"/>
                    <RadioButton x:Name="FOffline" Content="Kapalı" Style="{StaticResource ChipButton}" Checked="Filter_Checked"/>
                </StackPanel>
            </DockPanel>
            <DataGrid x:Name="DeviceGrid" MouseDoubleClick="Grid_DoubleClick" ContextMenuOpening="Grid_ContextMenuOpening">
                <DataGrid.ContextMenu>
                    <ContextMenu/>
                </DataGrid.ContextMenu>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Online}" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Conflict}" Value="True">
                                <Setter Property="Background" Value="#4A0F15"/>
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1E3A8A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Durum" Width="96" SortMemberPath="StatusText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" Margin="0,0,7,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#4B5568"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Online}" Value="True">
                                                        <Setter Property="Fill" Value="#22C55E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Conflict}" Value="True">
                                                        <Setter Property="Fill" Value="#EF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding StatusText}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="IP" Binding="{Binding Ip}" SortMemberPath="IpNum" Width="112"/>
                    <DataGridTextColumn Header="Ad" Binding="{Binding DisplayName}" Width="1.2*"/>
                    <DataGridTemplateColumn Header="Tür" Width="150" SortMemberPath="KindText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding KindReason}" Background="Transparent">
                                    <Viewbox Width="17" Height="17" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{Binding KindIcon}" Stroke="{Binding KindBrush}" StrokeThickness="1.8" StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding KindText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="140" FontFamily="Consolas"/>
                    <DataGridTextColumn Header="Üretici" Binding="{Binding Vendor}" Width="1.2*"/>
                    <DataGridTextColumn Header="Ping" Binding="{Binding PingText}" SortMemberPath="PingMs" Width="54"/>
                    <DataGridTemplateColumn Header="Portlar / web" Width="1.6*" SortMemberPath="PortsText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PortsText}" ToolTip="{Binding PortsText}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Son görülme" Binding="{Binding LastSeen, StringFormat=dd.MM HH:mm}" SortMemberPath="LastSeen" Width="100"/>
                    <DataGridTemplateColumn Header="Not / uyarı" Width="1.4*" SortMemberPath="Note">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Note}"/>
                                            <Setter Property="ToolTip" Value="{Binding Note}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Conflict}" Value="True">
                                                    <Setter Property="Text" Value="{Binding ConflictText}"/>
                                                    <Setter Property="ToolTip" Value="{Binding ConflictText}"/>
                                                    <Setter Property="Foreground" Value="#FECACA"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Olaylar -->
        <Border x:Name="EventsPanel" Grid.Row="3" Margin="14,10" Visibility="Collapsed" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="12,8">
                    <Button DockPanel.Dock="Right" Content="Günlük klasörünü aç" Click="OpenLogs_Click"/>
                    <TextBlock Text="Olaylar her gün ayrı dosyaya da yazılır (veri\olaylar)." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="12"/>
                </DockPanel>
                <ListBox x:Name="EventsList" ItemContainerStyle="{StaticResource PlainItem}" VirtualizingPanel.IsVirtualizing="True" Margin="6,0,6,6">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <TextBlock Text="{Binding TimeText}" Width="110" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                    <TextBlock Text="{Binding LevelText}" Width="70" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Top" Margin="0,1,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Alarm">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Uyari">
                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Duzeldi">
                                                        <Setter Property="Foreground" Value="#22C55E"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Durum çubuğu -->
        <Border Grid.Row="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Left" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,24,0"
                           Cursor="Hand" ToolTip="Güncellemeyi şimdi denetle" MouseLeftButtonUp="VersionText_Click"/>
                <TextBlock x:Name="ScanStatus" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                <TextBlock x:Name="Summary" FontSize="12"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
